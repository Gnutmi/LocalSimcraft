# Copy this file to `.env` and fill in your paths, OR set these as environment
# variables before running `npm start`. The server reads from process.env.

# Absolute path to your simc.exe (Windows) or simc binary (Mac/Linux).
# Windows default if unset: C:\SimulationCraft\simc.exe
SIMC_PATH=C:\SimulationCraft\simc.exe

# HTTP port the server listens on. Default 3737.
PORT=3737

# Bind address. 0.0.0.0 = reachable from your LAN. 127.0.0.1 = local-only.
HOST=0.0.0.0
